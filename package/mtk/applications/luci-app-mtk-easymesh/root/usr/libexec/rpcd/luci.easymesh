#!/usr/bin/env lua

local json = require "luci.jsonc"
local fs   = require "nixio.fs"
local util = require "luci.util"
local sys  = require "luci.sys"
local uci  = require "luci.model.uci"

local MAPD_CFG  = "/etc/map/mapd_cfg"
local MAP1905   = "/etc/map/1905d.cfg"
local WAPPCTRL  = "/sbin/wappctrl"
local STARTWAPP = "/sbin/startwapp.sh"

local function readfile(path)
	local s = fs.readfile(path)
	return s and (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function exec(cmd)
	local h = io.popen(cmd .. " 2>/dev/null")
	local out = h and h:read("*a") or ""
	if h then h:close() end
	return out or ""
end

local function run(cmd)
	return sys.call(cmd .. " >/dev/null 2>&1")
end

local function sed_escape(s)
	return tostring(s):gsub("\\", "\\\\"):gsub("&", "\\&"):gsub("|", "\\|")
end

local function sed_kv(file, key, value)
	if not fs.access(file) then return end
	run(string.format("sed -i 's|^%s=.*|%s=%s|' '%s'", key, key, sed_escape(value), file))
end

local function get_kv(file, key)
	if not fs.access(file) then return nil end
	local out = exec(string.format("sed -n 's|^%s=\\(.*\\)|\\1|p' '%s' | head -n1", key, file))
	out = out:gsub("^%s+", ""):gsub("%s+$", "")
	return (out ~= "") and out or nil
end

local function br_mac()
	local m = readfile("/sys/class/net/br-lan/address")
	return m and m:lower() or ""
end

local function proc_running(name)
	local out = exec("pgrep -x '" .. name .. "'")
	return out:gsub("%s+", "") ~= ""
end

local function mtwifi_radios()
	local cursor = uci.cursor()
	local radios = {}
	cursor:foreach("wireless", "wifi-device", function(s)
		if s.type == "mtwifi" then
			table.insert(radios, {
				name = s[".name"],
				band = s.band or "",
				channel = s.channel or "",
				dbdc_main = s.dbdc_main or "0"
			})
		end
	end)
	return radios
end

local function ifname_for_radio(name)
	local cursor = uci.cursor()
	local idx = cursor:get("wireless", name, "ifidx") or "0"
	local band = cursor:get("wireless", name, "band") or ""
	if band == "5g" or band == "5G" or name:match("_2$") then
		return "rax" .. idx
	end
	return "ra" .. idx
end

