	{ u = "dual_bh",              f = MAPD_CFG, k = "DualBH",                        d = "" },
	{ u = "bss_prio",             f = MAPD_CFG, k = "bss_config_priority",           d = "ra0;rax0;apclix0" },
	{ u = "ch_plan_enable",       f = MAPD_CFG, k = "ChPlanningEnable",              d = "0" },
