local function parse_stainfo(text)
	local stas = {}
	for line in text:gmatch("[^\r\n]+") do
		local mac = line:match("(%x%x:%x%x:%x%x:%x%x:%x%x:%x%x)")
		if mac then
			local rssi = line:match("(-%d+)")
			table.insert(stas, { mac = mac:upper(), rssi = rssi or "" })
		end
	end
	return stas
end

local function collect_stas()
	local all = {}
	for _, r in ipairs(mtwifi_radios()) do
		if r.dbdc_main == "1" then
			local ifn = ifname_for_radio(r.name)
			local raw = exec("iwpriv " .. ifn .. " show stainfo")
			local stas = parse_stainfo(raw)
			for _, s in ipairs(stas) do
				s.radio = r.name
				s.ifname = ifn
				s.band = r.band
				table.insert(all, s)
			end
		end
	end
	return all
end

local function current_role()
	local root = get_kv(MAP1905, "map_root")
	if root == "1" then return "controller" end
	if root == "0" then return "agent" end
	return "controller"
end

local methods = {
	getConfig = {
		call = function()
			local cursor = uci.cursor()
			local cfg = {}

			cfg.enabled = cursor:get("easymesh", "config", "enabled") or "0"
			cfg.device_mode = cursor:get("easymesh", "config", "device_mode") or "router"
			cfg.device_role = cursor:get("easymesh", "config", "device_role") or "controller"
			cfg.mesh_sr = cursor:get("easymesh", "config", "mesh_sr") or "1"
			cfg.bandsteering = cursor:get("easymesh", "config", "bandsteering") or "1"
			cfg.steeringthresold = cursor:get("easymesh", "config", "steeringthresold") or "-65"

			for _, e in ipairs(MAP_SCHEMA) do
				if cfg[e.u] == nil then
					cfg[e.u] = cursor:get("easymesh", "config", e.u) or e.d
				end
			end

			cfg.cur_mode = get_kv(MAPD_CFG, "mode") or "0"
			cfg.cur_role = current_role()
			print(json.stringify(cfg))
		end
	},

	getStatus = {
		call = function()
			local status = {
				wapp_running = proc_running("wapp"),
				bs20_running = proc_running("bs20"),
				al_mac = br_mac(),
				map_ver = get_kv(MAP1905, "map_ver") or "",
				device_role = current_role(),
				controller_alid = get_kv(MAP1905, "map_controller_alid") or "",
				agent_alid = get_kv(MAP1905, "map_agent_alid") or "",
				steer_enable = get_kv(MAPD_CFG, "SteerEnable") or "",
				radios = mtwifi_radios()
			}
			print(json.stringify(status))
		end
	},

	getTopology = {
		call = function()
			local topo = {
				al_mac = br_mac(),
				map_ver = get_kv(MAP1905, "map_ver") or "",
				device_role = current_role(),
				controller_alid = get_kv(MAP1905, "map_controller_alid") or "",
				agent_alid = get_kv(MAP1905, "map_agent_alid") or "",
				wapp_running = proc_running("wapp"),
				radios = mtwifi_radios(),
				stations = collect_stas()
			}
			print(json.stringify(topo))
		end
	},

	applyConfig = {
		call = function()
			local cursor = uci.cursor()
			local enabled = cursor:get("easymesh", "config", "enabled") or "0"
			local role = cursor:get("easymesh", "config", "device_role") or "controller"
			local mesh_sr = cursor:get("easymesh", "config", "mesh_sr") or "1"
			local bandsteering = cursor:get("easymesh", "config", "bandsteering") or "1"
			local steeringthresold = cursor:get("easymesh", "config", "steeringthresold") or "-65"

			local dev_role = (role == "agent") and "1" or "0"
			local map_root = (role == "agent") and "0" or "1"

			sed_kv(MAPD_CFG, "DeviceRole", dev_role)

			for _, e in ipairs(MAP_SCHEMA) do
				local v = cursor:get("easymesh", "config", e.u)
				if v == nil then v = e.d end
				sed_kv(e.f, e.k, v)
			end

			sed_kv(MAP1905, "map_root", map_root)
			sed_kv(MAP1905, "map_agent", "1")

			local al = br_mac()
			if al ~= "" then
				if role == "agent" then
					sed_kv(MAP1905, "map_agent_alid", al)
				else
					sed_kv(MAP1905, "map_controller_alid", al)
					sed_kv(MAP1905, "map_agent_alid", al)
				end
			end

			cursor:foreach("wireless", "wifi-device", function(s)
				if s.type == "mtwifi" then
					cursor:set("wireless", s[".name"], "wapp", enabled)
					cursor:set("wireless", s[".name"], "bandsteering", bandsteering)
					if enabled == "1" then
						cursor:set("wireless", s[".name"], "ieee80211r", mesh_sr)
					end
				end
			end)
			cursor:foreach("wireless", "wifi-iface", function(s)
				if s.mode == "ap" or s.mode == nil then
					cursor:set("wireless", s[".name"], "steeringthresold", steeringthresold)
				end
			end)
			cursor:commit("wireless")

			run("killall wapp bs20")
			if enabled == "1" and fs.access(STARTWAPP) then
				run(STARTWAPP)
			end

			print(json.stringify({ ok = true, enabled = enabled }))
		end
	},

	resetDefault = {
		call = function()
			sed_kv(MAPD_CFG, "DeviceRole", "0")
			sed_kv(MAP1905, "map_root", "1")
			sed_kv(MAP1905, "map_agent", "1")

			for _, e in ipairs(MAP_SCHEMA) do
				sed_kv(e.f, e.k, e.d)
			end

			local cursor = uci.cursor()
			cursor:set("easymesh", "config", "enabled", "0")
			cursor:set("easymesh", "config", "device_mode", "router")
			cursor:set("easymesh", "config", "device_role", "controller")
			cursor:set("easymesh", "config", "mesh_sr", "1")
			cursor:set("easymesh", "config", "bandsteering", "1")
			cursor:set("easymesh", "config", "steeringthresold", "-65")
			for _, e in ipairs(MAP_SCHEMA) do
				cursor:set("easymesh", "config", e.u, e.d)
			end
			cursor:commit("easymesh")

			cursor:foreach("wireless", "wifi-device", function(s)
				if s.type == "mtwifi" then
					cursor:set("wireless", s[".name"], "wapp", "0")
				end
			end)
			cursor:commit("wireless")

			run("killall wapp bs20")

			print(json.stringify({ ok = true }))
		end
	},

	pbcTrigger = {
		args = { iface = "" },
		call = function(args)
			local iface = (args and args.iface ~= "") and args.iface or "ra0"
			local out = exec(WAPPCTRL .. " " .. iface .. " wps_pbc_trigger")
			print(json.stringify({ ok = true, output = out }))
		end
	},

	dppUriAdd = {
		args = { uri = "" },
		call = function(args)
			local uri = (args and args.uri) or ""
			sed_kv(MAPD_CFG, "dpp%-uri", uri)
			local cursor = uci.cursor()
			cursor:set("easymesh", "config", "dpp_uri", uri)
			cursor:commit("easymesh")
			print(json.stringify({ ok = true }))
		end
	},

	dppUriShow = {
		call = function()
			local out = exec(WAPPCTRL .. " ra0 dpp_bootstrap_get_uri 0")
			print(json.stringify({ uri = get_kv(MAPD_CFG, "dpp%-uri") or "", output = out }))
		end
	}
}

local function parseInput()
	local parse = json.new()
	local done, err
	while true do
		local chunk = io.read(4096)
		if not chunk then break
		elseif not done and not err then
			done, err = parse:parse(chunk)
		end
	end
	if not done then
		print(json.stringify({ error = err or "Incomplete input" }))
		os.exit(1)
	end
	return parse:get()
end

local function validateArgs(func, uargs)
	local method = methods[func]
	if not method then
		print(json.stringify({ error = "Method not found" }))
		os.exit(1)
	end
	if type(uargs) ~= "table" then
		print(json.stringify({ error = "Invalid arguments" }))
		os.exit(1)
	end
	uargs.ubus_rpc_session = nil
	local margs = method.args or {}
	for k, v in pairs(uargs) do
		if margs[k] == nil or (v ~= nil and type(v) ~= type(margs[k])) then
			print(json.stringify({ error = "Invalid arguments" }))
			os.exit(1)
		end
	end
	return method
end

if arg[1] == "list" then
	local rv = {}
	for name, method in pairs(methods) do
		rv[name] = method.args or {}
	end
	print((json.stringify(rv):gsub(":%[%]", ":{}")))
elseif arg[1] == "call" then
	local args = parseInput()
	local method = validateArgs(arg[2], args)
	local result, code = method.call(args)
	print((json.stringify(result):gsub("^%[%]$", "{}")))
	os.exit(code or 0)
end
