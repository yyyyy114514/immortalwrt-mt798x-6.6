config easymesh 'config'
	option enabled '0'
	option device_mode 'router'
	option device_role 'controller'
	option mesh_sr '1'
	option bandsteering '1'
	option steeringthresold '-65'

	# steering / roaming (mapd_cfg)
	option steering '1'
	option steer_rssi_th '-54'
	option roam_rssi_th '-70'
	option lr_steer_edge '25'
	option lr_steer_edge_root ''
	option scan_th_2g '-88'
	option scan_th_5g '-88'
	option scan_th_6g '-88'
	option bh_steer_timeout '120'
	option centralized_steering '0'
	option metric_interval '60'
	option max_scan ''

	# map feature switches (mapd_cfg)
	option non_map_ap '1'
	option third_party '0'
	option role_detect_ext '0'
	option dhcp_ctl '0'
	option quick_ch_change '1'
	option psc_6g '0'
	option dpp_uri ''

	# device / data element info (mapd_cfg)
	option lan_if 'eth0'
	option wan_if 'eth1'
	option de_serial 'v3.0'
	option de_sw_ver 'v3.0'
	option de_exec_env 'Linux-Openwrt'
	option de_chipset_vendor 'MediaTek'
	option de_sta_event_path ''

	# backhaul (mapd_cfg / 1905d.cfg)
	option bh_prio_2g '0'
	option bh_prio_5gl '1'
	option bh_prio_5gh '1'
	option bh_prio_6g '1'
	option auto_bh_switch '1'
	option dual_bh ''
	option band_switch_time ''
	option bss_prio 'ra0;rax0;apclix0'
	option bh_type 'eth'

	# backhaul STA profiles (mapd_cfg)
	option bh0_valid '0'
	option bh0_ssid ''
	option bh0_auth ''
	option bh0_enc ''
	option bh0_key ''
	option bh0_raid ''
	option bh1_valid '0'
	option bh1_ssid ''
	option bh1_auth ''
	option bh1_enc ''
	option bh1_key ''
	option bh1_raid ''
	option bh2_valid '0'
	option bh2_ssid ''
	option bh2_auth ''
	option bh2_enc ''
	option bh2_key ''
	option bh2_raid ''

	# channel planning (mapd_cfg)
	option ch_plan_enable '0'
	option ch_plan_enable_r2 ''
	option ch_plan_r2_bw ''
	option ch_plan_init_timeout '120'
	option ch_plan_scan_valid '14400'
	option ch_plan_idle_bytes ''
	option ch_plan_idle_time ''
	option ch_plan_ch_2g ''
	option ch_plan_ch_5gl ''
	option ch_plan_ch_5gh ''
	option ch_plan_ch_6g ''
	option ch_plan_cu_th_2g ''
	option ch_plan_cu_th_5gl ''
	option ch_plan_cu_th_6g ''
	option ch_plan_edcca_th_2g ''
	option ch_plan_edcca_th_5gl ''
	option ch_plan_edcca_th_6g ''
	option ch_plan_obss_th_2g ''
	option ch_plan_obss_th_5gl ''
	option ch_plan_obss_th_6g ''
	option ch_plan_r2_metric_intv ''
	option ch_plan_r2_min_score ''
	option ch_plan_r2_mon_prohibit ''
	option ch_plan_r2_mon_timeout ''
	option divergent_ch_plan '0'

	# network optimization (mapd_cfg)
	option nop_enable '0'
	option nop_bootup_wait '45'
	option nop_connect_wait '45'
	option nop_disconnect_wait '45'
	option nop_periodicity '3600'
	option nop_score_margin '100'
	option nop_prefer_5g '0'
	option nop_prefer_5g_retry '0'
	option nop_post_cac '30'
	option nop_data_collect '60'
	option nop_user_prio '0'

	# channel utilization thresholds (mapd_cfg)
	option cu_th_2g '70'
	option cu_th_5gl '80'
	option cu_th_5gh '80'
	option cu_th_6g '80'

	# 1905d.cfg
	option radio_band '24G;5G;5G;'
	option br_inf 'br-lan'
	option al_inf 'ra0'
	option eth_dev ''
	option map_ver 'R1'
	option decrypt_fail_th '10'
	option gtk_rekey '3600'
	option ob_wan_only '0'
	option ctrl_alid ''
	option agent_alid ''
